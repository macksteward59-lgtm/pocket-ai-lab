{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true
  },
  "include": ["packages/intelligence/**/*", "runtime/adapters/**/*", "runtime/lab/**/*", "src/**/*", "scripts/desktop/**/*.ts"],
  "exclude": ["node_modules", "packages/director", "packages/exploitgym"]
}
